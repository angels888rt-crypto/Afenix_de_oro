# ============================================================
#  Servicio de impresión térmica — Afenix de Oro
#  Copia este archivo como .env y ajusta los valores.
#  El archivo .env nunca debe subirse al repositorio.
# ============================================================

# ── Backend FastAPI ──────────────────────────────────────────────────────────
# URL del servidor donde corre el backend.
# Si el servicio corre en el mismo PC que el backend, usa localhost.
# Si corre en otro equipo de la red, usa su IP local: http://192.168.1.10:8000
API_BASE_URL=http://localhost:8000

# Clave de API — debe ser idéntica al valor de PRINTER_API_KEY en project/.env
PRINTER_API_KEY=afenix-print-2026

# Timeout HTTP en segundos para las peticiones al backend
HTTP_TIMEOUT_SECONDS=10

# ── Impresora ────────────────────────────────────────────────────────────────
# Nombre exacto tal como aparece en:
#   Panel de Control → Dispositivos e impresoras
# Ejemplos:
#   PRINTER_NAME=JALTECH JALP58
#   PRINTER_NAME=JALL P58 Series
#   PRINTER_NAME=Generic / Text Only
PRINTER_NAME=JALTECH JALP58

# Ancho de papel en caracteres (58mm ~ 32 chars con fuente normal 9pt)
PAPER_CHAR_WIDTH=32

# ── Configuración del recibo (FALLBACK) ──────────────────────────────────────
# Estos valores se usan SOLO si GET /api/v1/receipt-config falla o el
# backend no está disponible al arrancar.
# En condiciones normales, los valores vienen de la base de datos y son
# administrables desde el panel admin → Configuración del recibo.
RESTAURANT_NAME=RESTAURANTE
FOOTER_MESSAGE=¡Gracias por su visita!

# ── Polling ──────────────────────────────────────────────────────────────────
# Segundos entre cada consulta de pedidos pendientes al backend
POLL_INTERVAL_SECONDS=5

# ── Recuperación de pedidos bloqueados en PRINTING ───────────────────────────
# Si un pedido lleva más de este tiempo en PRINTING (crash / apagón durante
# la impresión), se mueve a RECOVERY_REQUIRED para revisión manual.
# Debe ser mayor que el tiempo máximo de impresión de un ticket (~30 segundos).
# Recomendado: 5 minutos.
PRINTING_TIMEOUT_MINUTES=5

# ── Backoff progresivo para impresora no disponible ──────────────────────────
# Cuando la impresora está apagada o desconectada, el servicio reintenta
# con espera creciente para no saturar los logs ni la CPU.
#
# Fórmula: delay = BASE × MULTIPLIER^(failure_count - 1), máximo MAX
#   1er fallo → 30s
#   2do fallo → 60s
#   3er fallo → 120s
#   4to fallo → 240s
#   5to fallo → 300s (máximo)
#   ... sin límite de intentos: el pedido queda en PENDING hasta que la
#       impresora vuelva a estar disponible.
PRINT_BACKOFF_BASE_SECONDS=30
PRINT_BACKOFF_MULTIPLIER=2.0
PRINT_BACKOFF_MAX_SECONDS=300

# ── Logging ──────────────────────────────────────────────────────────────────
# Nivel: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=printer_service.log
