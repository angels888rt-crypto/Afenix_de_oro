{
  "info": {
    "name": "Fénix de Oro - Flujo de pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "token", "value": ""},
    {"key": "order_id", "value": "1"}
  ],
  "item": [
    {
      "name": "1. Login (cualquier rol)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"username\": \"mesero\",\n  \"password\": \"TuPassword\"\n}"},
        "url": {"raw": "{{base_url}}/api/v1/users/login", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "login"]}
      },
      "event": [{"listen": "test", "script": {"exec": ["const json = pm.response.json();", "if (json?.data?.access_token) pm.collectionVariables.set('token', json.data.access_token);"]}}]
    },
    {
      "name": "Mesero - GET mis pedidos",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{base_url}}/api/v1/orders/mine?limit=100", "host": ["{{base_url}}"], "path": ["api", "v1", "orders", "mine"], "query": [{"key": "limit", "value": "100"}]}
      }
    },
    {
      "name": "Cocinero - GET pedidos de cocina",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{base_url}}/api/v1/orders/kitchen?limit=100", "host": ["{{base_url}}"], "path": ["api", "v1", "orders", "kitchen"], "query": [{"key": "limit", "value": "100"}]}
      }
    },
    {
      "name": "Cocinero - marcar COMPLETADO",
      "request": {
        "method": "PUT",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"status\": \"COMPLETADO\"\n}"},
        "url": {"raw": "{{base_url}}/api/v1/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "orders", "{{order_id}}"]}
      }
    },
    {
      "name": "Mesero - marcar ENTREGADO",
      "request": {
        "method": "PUT",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"status\": \"ENTREGADO\"\n}"},
        "url": {"raw": "{{base_url}}/api/v1/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "orders", "{{order_id}}"]}
      }
    },
    {
      "name": "Admin - GET historial completo",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{base_url}}/api/v1/orders/history?limit=100", "host": ["{{base_url}}"], "path": ["api", "v1", "orders", "history"], "query": [{"key": "limit", "value": "100"}]}
      }
    }
  ]
}
